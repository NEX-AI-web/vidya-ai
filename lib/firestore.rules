rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if owns(uid);
    }

    match /students/{uid} {
      allow create, update, read: if owns(uid)
        || (signedIn() && exists(/databases/$(database)/documents/parents/$(request.auth.uid)/students/$(uid)));
    }

    match /studentCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && !exists(/databases/$(database)/documents/studentCodes/$(code));
      allow update, delete: if false;
    }

    match /parents/{parentUid}/students/{studentUid} {
      allow read, delete: if owns(parentUid);
      allow create: if owns(parentUid)
        && exists(/databases/$(database)/documents/studentCodes/$(request.resource.data.studentCode))
        && get(/databases/$(database)/documents/studentCodes/$(request.resource.data.studentCode)).data.studentUid == studentUid;
      allow update: if false;
    }

    match /teachers/{teacherUid} {
      allow read, write: if owns(teacherUid);

      match /materials/{materialId} {
        allow read, create, update, delete: if owns(teacherUid);
      }
    }

    match /teacherCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.teacherUid == request.auth.uid
        && !exists(/databases/$(database)/documents/teacherCodes/$(code));
      allow update, delete: if false;
    }
  }
}